# Django Configuration
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gmail.com
DJANGO_SUPERUSER_PASSWORD=change-me-before-first-run
DJANGO_SETTINGS_MODULE=config.settings_prod

REDIS_URL=redis://redis:6379/0

# Database Configuration
DATABASE_URL=postgres://speakle_user:change-me@db:5432/speakle
POSTGRES_DB=speakle
POSTGRES_USER=speakle_user
POSTGRES_PASSWORD=change-me

# Redis Configuration (for Django Channels)
REDIS_URL=redis://redis:6379/0

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security Settings
SECURE_SSL_REDIRECT=False
# Set True only if your HTTPS proxy sets/overwrites X-Forwarded-Proto. Needed before SECURE_SSL_REDIRECT=True.
TRUST_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# CSRF Settings (Important for form submissions)
CSRF_TRUSTED_ORIGINS=http://localhost:8001,https://localhost:8001,http://yourdomain.com,https://yourdomain.com
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_USE_SESSIONS=False

# Media and Static Files
MEDIA_URL=/media/
STATIC_URL=/static/

# Time Zone
TIME_ZONE=Asia/Seoul

# Language Code
LANGUAGE_CODE=en-us

# Public origin (canonical URLs, sitemap, share images, email links)
SITE_URL=https://yourdomain.com

# Quick match needs a verified email by default
QUICK_MATCH_REQUIRE_VERIFIED_EMAIL=True
 # Optional: cap sign-ups per client address per hour (0 = off). Leave off behind a proxy that hides client IPs.
SIGNUPS_PER_HOUR_PER_IP=0

# WebRTC ICE servers for video calls (optional). Default: five public Google STUN servers, no TURN.
# Add a TURN relay so calls also connect on strict NATs and some mobile networks.
# The TURN username and credential are sent to call participants' browsers: use a dedicated user.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
